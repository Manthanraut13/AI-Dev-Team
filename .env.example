# AI Dev Team plugin — v2 .env template
# Copy to `.env` and fill in. Never commit `.env`.
# Only GROQ_API_KEY is required; everything else is optional and degrades gracefully.

# LLM (required)
GROQ_API_KEY=

# Tracing (LangSmith, optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-dev-team

# Search & Crawl (optional — Research agent)
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# GitHub (optional — Docs auto-commit, GitHub automation)
GITHUB_TOKEN=
GITHUB_USERNAME=

# Long-term memory (Qdrant, optional — degrades gracefully)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Model routing (optional overrides; defaults proven on this machine)
# PLANNING_MODEL=llama-3.3-70b-versatile
# CODE_MODEL=qwen/qwen3.6-27b
# REVIEW_MODEL=openai/gpt-oss-120b
# DOCS_MODEL=openai/gpt-oss-20b
